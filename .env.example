# ==============================================================================
# EcoCampus AI - Environment Configuration Example
# DSU Code Clash 2.0 - Problem Statement: AI-Powered Sustainable Campus
# ==============================================================================
#
# SECURITY & PRIVACY NOTICE:
# - EcoCampus AI runs 100% out-of-the-box in standalone local demo mode.
# - DO NOT place real production API keys or credentials in client-facing files.
# - If connecting to an external LLM or Computer Vision proxy service,
#   copy this file to .env and configure the parameters below on your server proxy.
# ==============================================================================

# Server Hosting Port
PORT=5173

# Optional LLM API Proxy Configuration (for GenAI Copilot external integration)
# Supported Providers: OpenAI / Anthropic / Google Gemini
LLM_PROVIDER=local_grounded
LLM_API_KEY=your_optional_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash
LLM_MAX_TOKENS=1024

# Optional Computer Vision Model Endpoint
CV_MODEL_ENDPOINT=https://your-custom-cv-endpoint.demo/v1/triage
CV_API_KEY=your_optional_cv_key_here

# Baseline Engineering Assumptions (Defaults used if omitted)
DEFAULT_LEAK_RATE_LPM=3.5
DEFAULT_HVAC_POWER_KW=3.2
DEFAULT_GRID_EMISSION_FACTOR=0.82
